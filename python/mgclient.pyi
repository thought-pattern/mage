"""Static declarations for the native mgclient API used by MAGE."""

MG_SSLMODE_DISABLE: int
MG_SSLMODE_REQUIRE: int

class Error(Exception): ...
class DatabaseError(Error): ...

class Node:
    @property
    def labels(self) -> list[str]: ...
    @property
    def properties(self) -> dict[str, object]: ...

class Relationship:
    @property
    def type(self) -> str: ...
    @property
    def properties(self) -> dict[str, object]: ...

class Cursor:
    def execute(self, operation: str) -> None: ...
    def fetchall(self) -> list[tuple[object, ...]]: ...

class Connection:
    autocommit: bool
    def cursor(self) -> Cursor: ...
    def close(self) -> None: ...

def connect(*, host: str, port: int = ..., username: str = ..., password: str = ..., sslmode: int = ...) -> Connection: ...
